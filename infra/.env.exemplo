# =============================================================================
#  Variáveis do servidor. Copie para infra/.env, preencha e proteja:
#    cp .env.exemplo .env && chmod 600 .env
#  Use aspas SIMPLES nos valores (o painel do Traefik tem "$" na senha).
#  Gere chaves novas com: openssl rand -hex 32
# =============================================================================

# --- Domínios -----------------------------------------------------------------
# DNS: crie registros A apontando para o IP público do servidor.
DOMINIO='manutencao.seudominio.com.br'
TRAEFIK_DOMINIO='traefik.seudominio.com.br'
# E-mail para o Let's Encrypt avisar sobre certificados.
ACME_EMAIL='voce@seudominio.com.br'

# --- Imagens (GitHub Container Registry) ---------------------------------------
IMAGEM_BASE='ghcr.io/dhqdev/manutencao-ativos'
TAG='latest'

# --- Banco --------------------------------------------------------------------
# Senha do superusuário do Postgres (migrador e backup).
POSTGRES_PASSWORD=''
# Senha do usuário "authenticator" (com que o PostgREST conecta). Só letras e números.
AUTHENTICATOR_PASSWORD=''

# --- Chaves do app --------------------------------------------------------------
# Assina os tokens do app para o PostgREST (o PostgREST usa a mesma). 64 caracteres.
JWT_SECRET=''
# Assina o cookie de sessão dos usuários.
SESSAO_SECRET=''
# Assina os links de fotos e anexos.
ARQUIVOS_SECRET=''
# Protege a rotina diária (/api/notificacoes/disparar), usada pelo serviço cron.
CRON_SECRET=''
# Chave entre o app e o serviço de WhatsApp.
WHATSAPP_API_KEY=''

# --- Painel do Traefik (https://TRAEFIK_DOMINIO) ---------------------------------
# Formato htpasswd: usuario:hash   (gere com: openssl passwd -apr1 'SUA_SENHA')
TRAEFIK_PAINEL_USUARIOS=''

# --- Superadmin (painel /admin: todas as empresas e usuários) -------------------
# O migrador cria esse login a cada deploy (ou acerta a senha, se mudou).
# Senha com pelo menos 8 caracteres. Vazio = nenhum superadmin.
SUPERADMIN_EMAIL=''
SUPERADMIN_SENHA=''

# --- Cadastro -------------------------------------------------------------------
# false = só entra quem for criado por um gestor (cadastro público fechado).
CADASTRO_ABERTO='true'

# --- Arquivos -------------------------------------------------------------------
# Espaço de fotos e anexos por empresa, em MB (0 = sem limite). Padrão: 5 GB.
ARQUIVOS_COTA_MB='5120'

# --- E-mail (opcional, só para "Esqueci minha senha") ---------------------------
SMTP_HOST=''
SMTP_PORTA='587'
SMTP_USUARIO=''
SMTP_SENHA=''
SMTP_REMETENTE='Gestão de Manutenção <nao-responda@seudominio.com.br>'

# --- WhatsApp (opcionais) -------------------------------------------------------
WHATSAPP_SEMPRE_ONLINE='true'
WHATSAPP_DIGITANDO='true'
WHATSAPP_REJEITAR_CHAMADAS='false'

# --- Backup ---------------------------------------------------------------------
BACKUP_DIAS='14'
BACKUP_HORA='3'
# Backup automático a cada N dias (o console do superadmin pode mudar).
BACKUP_CADA_DIAS='15'

# --- Backup no Backblaze B2 (opcional, recomendado) -----------------------------
# Backblaze → Buckets → Create (privado) e Application Keys → Add (acesso só a
# esse bucket, Read and Write). Prefira colar a chave no console do superadmin
# (Gerência → Integrações): estas variáveis só valem com o console vazio.
B2_KEY_ID=''
B2_APP_KEY=''
B2_BUCKET=''
B2_PASTA='manutencao'
# espelho: o bucket fica igual ao app (só o dump mais novo, apagado no app some
# do B2). historico: guarda os dumps e os arquivos apagados por B2_DIAS dias.
B2_MODO='espelho'
B2_DIAS='30'
# Opcional (pode deixar vazio): criptografa antes de sair do servidor. Sem essa senha, o backup não abre.
B2_SENHA_CRIPTOGRAFIA=''
