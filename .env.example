# Desenvolvimento local (npm run dev). Suba o banco antes:
#   docker compose -f infra/dev.yml up -d
# Em produção as variáveis ficam em infra/.env (veja INSTALACAO.md).

SITE_URL=http://localhost:3001
POSTGREST_URL=http://localhost:3002

# Mesmos valores de infra/dev.yml (só para desenvolvimento!)
JWT_SECRET=dev-jwt-secret-com-pelo-menos-32-caracteres-aqui
SESSAO_SECRET=dev-sessao-secret-com-pelo-menos-32-caracteres
ARQUIVOS_SECRET=dev-arquivos-secret-com-pelo-menos-32-caracteres
CRON_SECRET=dev-cron
ARQUIVOS_DIR=./.arquivos

# WhatsApp (opcional em dev): cd whatsapp && npm start
WHATSAPP_API_URL=http://localhost:3003
WHATSAPP_API_KEY=dev-whatsapp-chave-com-mais-de-24-caracteres

# E-mail (opcional)
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
SMTP_REMETENTE=

# Origens extras liberadas para o hot-reload (túneis, outro domínio local).
# DEV_ORIGINS=meu-tunel.trycloudflare.com
